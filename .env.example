# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# SQLite (default — works with no extra installation):
DATABASE_URL=sqlite:///./app.db

# PostgreSQL (optional — uncomment and fill in if you want Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/taskflow

APP_ENV=development

# Allowed frontend origins — comma-separated.
# Add the port your static server uses (VS Code Live Server defaults to 5500).
# "null" covers opening index.html directly from the filesystem (file://).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null
